# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://flockoff:flockoff@localhost:5434/flockoff?schema=public"
# Direct (non-pooled) connection for migrations. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://flockoff:flockoff@localhost:5434/flockoff?schema=public"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
# Required when self-hosting with `next start` (Vercel sets this automatically).
AUTH_TRUST_HOST="true"
# Public origin for canonical URLs, sitemap and social previews (set before building).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin account created by `pnpm db:seed`
SEED_ADMIN_EMAIL="admin@flockoff.local"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_FIRST_NAME="Flock"
SEED_ADMIN_LAST_NAME="Admin"

# Product image storage: "local" (dev, ./uploads) or "cloudinary"
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="flockoff/products"
